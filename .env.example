PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# Frontend URLs allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000
# Public website address, used for links inside emails (product pages, unsubscribe)
SITE_URL=https://globalshelfbd.com
RESET_OTP_EXPIRE_MINUTES=10
# Secret key used to hash password reset OTPs
OTP_SECRET=

# First Admin account (created on server start if no Admin exists)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@globalshelfbd.com
ADMIN_PASSWORD=

# Max login/register/password attempts per IP per 15 minutes
AUTH_RATE_LIMIT=100

# Max newsletter subscribe attempts per IP per 15 minutes
NEWSLETTER_RATE_LIMIT=10
CONTACT_RATE_LIMIT=5

# Max bulk courier sync calls per IP per 5 minutes (default 6)
COURIER_BULK_SYNC_RATE_LIMIT=6

# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limits see real visitor IPs
# TRUST_PROXY=1

# Delivery charge in BDT (city "Dhaka" = inside Dhaka, any other city = outside)
SHIPPING_COST_INSIDE_DHAKA=80
SHIPPING_COST_OUTSIDE_DHAKA=130

# Image upload (Cloudinary). Leave empty to store images locally in /uploads (development only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_FILE_SIZE_MB=5

# Email (Resend HTTP API - no SMTP). Domain globalshelfbd.com is verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=GlobalShelfBD <no-reply@globalshelfbd.com>

# Steadfast Courier (packzy portal) integration. Leave blank to disable;
# booking endpoints will refuse with 503 until both keys are set.
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_TIMEOUT_MS=15000
STEADFAST_STATUS_CACHE_MS=60000

# Google OAuth (not implemented yet)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
